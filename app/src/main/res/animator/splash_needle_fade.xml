<?xml version="1.0" encoding="utf-8"?>
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android" android:duration="1000">
    <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0"/>
        <keyframe android:fraction="0.12" android:value="0"/>
        <keyframe android:fraction="0.30" android:value="1" android:interpolator="@android:interpolator/linear"/>
        <keyframe android:fraction="1" android:value="1"/>
    </propertyValuesHolder>
</objectAnimator>
